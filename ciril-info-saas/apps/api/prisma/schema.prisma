// CirilInfo SaaS Platform — PostgreSQL schema
//
// Conventions
//  - UUID primary keys (gen_random_uuid()), snake_case tables/columns via @@map/@map.
//  - All timestamps are timestamptz and written in UTC.
//  - Money is NUMERIC(14,2) + ISO-4217 currency (default INR). Never floats.
//  - Every tenant-owned table has a non-null tenant_id and is protected by
//    PostgreSQL Row-Level Security (see migrations/*_rls). Tenant-owned child
//    tables carry tenant_id too (denormalised) so RLS never needs a join.
//  - Catalogue and platform tables (products, plans, servers, registrars,
//    settings) are global and not tenant-scoped.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum RoleScope {
  PLATFORM
  TENANT
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum ProductType {
  WEB_HOSTING
  WORDPRESS_HOSTING
  CLOUD_HOSTING
  VPS_HOSTING
  DOMAIN
  BUSINESS_EMAIL
  WEBSITE_DESIGN
  WEBSITE_DEVELOPMENT
  WEBSITE_MAINTENANCE
  SEO
  DIGITAL_MARKETING
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  BIENNIAL
  TRIENNIAL
  ONE_TIME
}

enum DiscountType {
  PERCENT
  FIXED
}

enum HostingPanel {
  CPANEL
  PLESK
  MOCK
}

enum ServerStatus {
  ACTIVE
  MAINTENANCE
  FULL
  RETIRED
}

enum HostingAccountStatus {
  PENDING
  PROVISIONING
  ACTIVE
  SUSPENDED
  CANCELLED
  FAILED
  TERMINATED
}

enum JobStatus {
  QUEUED
  RUNNING
  /// Manual hosting mode: waiting for staff to do it by hand.
  AWAITING_STAFF
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ProvisioningAction {
  CREATE
  SUSPEND
  UNSUSPEND
  CHANGE_PLAN
  TERMINATE
}

enum DomainStatus {
  PENDING_REGISTRATION
  PENDING_TRANSFER
  ACTIVE
  EXPIRED
  REDEMPTION
  CANCELLED
  TRANSFERRED_OUT
  FAILED
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  SRV
  CAA
}

enum ContactChangeStatus {
  REQUESTED
  DONE
  CANCELLED
}

enum NameserverChangeStatus {
  REQUESTED
  DONE
  CANCELLED
}

enum TransferOutStatus {
  REQUESTED
  RELEASED
  COMPLETED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  PENDING_AUTH
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum SubscriptionEvent {
  CREATED
  ACTIVATED
  RENEWED
  UPGRADED
  DOWNGRADED
  CANCEL_REQUESTED
  CANCELLED
  EXPIRED
  SUSPENDED
  REACTIVATED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  VOID
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
