# Settings for the production server. Copy this file to /opt/cirilinfo/.env on the server, fill it in, and run:
#   chmod 600 /opt/cirilinfo/.env
# This file lives in Git with placeholders only. The real .env must NEVER go into Git, chat, tickets or screenshots.
# See DEPLOYMENT.md for how each value is made. Anything that says CHANGE_ME must be replaced.

# ─── Which release to run ───
REGISTRY=ghcr.io/cirilinfo
# The tag of the images you built or pulled, for example 2026-11-20.1
IMAGE_TAG=CHANGE_ME

# ─── Database and queue (private to the server; never opened to the internet) ───
# Make each with: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_PLATFORM_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ─── Secrets that protect your data ───
# openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
# EXACTLY 32 random bytes, base64: openssl rand -base64 32
# KEEP A COPY OF THIS SOMEWHERE SAFE, SEPARATE FROM THE SERVER. Without it, the encrypted data in a restored backup
# (two-step sign-in secrets, domain transfer codes) cannot be read, and every staff member would have to set up two-step again.
DATA_ENCRYPTION_KEY=CHANGE_ME
# Leave empty unless sign-in cookies must be shared across subdomains, for example .cirilinfo.com
COOKIE_DOMAIN=

# ─── Email (Resend) ───
EMAIL_PROVIDER=resend
EMAIL_FROM=CirilInfo <hello@cirilinfo.com>
RESEND_API_KEY=CHANGE_ME

# ─── Payments (Razorpay, live keys). See PAYMENTS.md ───
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ─── Hosting accounts and DNS (cPanel/WHM). See HOSTING.md ───
# cpanel = accounts are created on your WHM server. manual = your team creates them by hand and marks the task done.
HOSTING_PROVIDER=cpanel
# cpanel = customers edit DNS records on your WHM server. none = customer DNS editing is switched off (use this until WHM is
# connected). The mock is refused in production.
DNS_PROVIDER=cpanel
CPANEL_HOST=server.yourdomain.com
CPANEL_PORT=2087
CPANEL_USER=root
CPANEL_API_TOKEN=CHANGE_ME
# verify = check the server's certificate (recommended). skip = do not check it (self-signed server).
CPANEL_TLS=verify

# ─── Domains ───
# rdap = ask the public registry whether a name is taken (real answers, no registrar account needed).
# Registering, renewing and transferring domains is still done by hand at your registrar.
REGISTRAR_PROVIDER=rdap

# ─── Uploaded files ───
# local = a persistent Docker volume on the server (backed up by infra/backup/backup.sh). The S3 driver is not built yet.
STORAGE_DRIVER=local

# ─── Optional ───
LOG_LEVEL=info
# Error tracking: a Sentry DSN, or leave empty.
SENTRY_DSN=
# Billing rhythm. The defaults are sensible; change them only on purpose.
RENEWAL_LEAD_DAYS=14
PAST_DUE_GRACE_DAYS=7
ABANDONED_ORDER_DAYS=14
