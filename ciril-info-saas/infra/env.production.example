# Settings for the production server. Copy this file to /opt/cirilinfo/.env on the server, fill it in, and run:
#   chmod 600 /opt/cirilinfo/.env
# This file lives in Git with placeholders only. The real .env must NEVER go into Git, chat, tickets or screenshots.
# See DEPLOYMENT.md for how each value is made. Anything that says CHANGE_ME must be replaced.

# ─── Which release to run ───
REGISTRY=ghcr.io/cirilinfo
# The tag of the images you built or pulled, for example 2026-11-20.1
IMAGE_TAG=CHANGE_ME

# ─── Database and queue (private to the server; never opened to the internet) ───
# Make each with: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DB_OWNER_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_PLATFORM_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ─── Secrets that protect your data ───
# openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
# EXACTLY 32 random bytes, base64: openssl rand -base64 32
# KEEP A COPY OF THIS SOMEWHERE SAFE, SEPARATE FROM THE SERVER. Without it, the encrypted data in a restored backup
# (two-step sign-in secrets, domain transfer codes) cannot be read, and every staff member would have to set up two-step again.
DATA_ENCRYPTION_KEY=CHANGE_ME
# Leave empty unless sign-in cookies must be shared across subdomains, for example .cirilinfo.com
COOKIE_DOMAIN=

# ─── Email ───
# Without working email nobody can verify their address and sign in. Choose one:
#   smtp   = your own mailbox (e.g. noreply@cirilinfo.com, made in hPanel > Emails). EMAIL_FROM must use that address.
#   resend = Resend's service (needs your domain verified there).   ses = Amazon SES (below).
EMAIL_PROVIDER=resend
EMAIL_FROM=CirilInfo <hello@cirilinfo.com>
RESEND_API_KEY=CHANGE_ME
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=CirilInfo <noreply@cirilinfo.com>
# EMAIL_REPLY_TO=support@cirilinfo.com
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@cirilinfo.com
# SMTP_PASSWORD=CHANGE_ME
# Or Amazon SES instead of Resend: EMAIL_PROVIDER=ses and an IAM key allowed only ses:SendEmail
# AWS_SES_REGION=ap-south-1
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_CONFIGURATION_SET=

# ─── Payments (Razorpay, live keys). See PAYMENTS.md ───
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
# Pre-launch only: true lets production run with a Razorpay TEST key (rzp_test_...) while Razorpay reviews the site
# before issuing live keys. No real money moves. Delete this line when the live key goes in (a live key is refused while it is on).
# RAZORPAY_TEST_KEYS_IN_PRODUCTION=true
# Optional: Stripe alongside Razorpay for international cards (live keys). See PAYMENTS.md.
# STRIPE_SECRET_KEY=sk_live_CHANGE_ME
# STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# true only once Razorpay has switched on Recurring Payments (cards) for your account
RAZORPAY_SAVED_CARDS=false
CARD_AUTOPAY_MAX_AMOUNT=15000

# ─── Hosting accounts and DNS (cPanel/WHM). See HOSTING.md ───
# cpanel = accounts are created on your WHM server. manual = your team creates them by hand and marks the task done.
HOSTING_PROVIDER=cpanel
# cpanel = customers edit DNS records on your WHM server. none = customer DNS editing is switched off (use this until WHM is
# connected). The mock is refused in production.
DNS_PROVIDER=cpanel
CPANEL_HOST=server.yourdomain.com
CPANEL_PORT=2087
CPANEL_USER=root
CPANEL_API_TOKEN=CHANGE_ME
# verify = check the server's certificate (recommended). skip = do not check it (self-signed server).
CPANEL_TLS=verify
# Or several servers (cPanel and Plesk), added in Admin > Hosting servers: HOSTING_PROVIDER=servers
# Or Plesk instead: HOSTING_PROVIDER=plesk, DNS_PROVIDER=none, and (see HOSTING.md)
# PLESK_HOST=
# PLESK_API_KEY=
# PLESK_IP=
# PLESK_TLS=verify

# ─── Domains ───
# rdap = ask the public registry whether a name is taken (real answers, no registrar account needed).
#        Registering, renewing and transferring domains is done by hand at your registrar.
# resellerclub = searches and paid orders go through ResellerClub automatically (see DOMAINS.md). Production needs RESELLERCLUB_ENV=live,
#        and this server's IP address on the allowed list in the ResellerClub panel (Settings > API).
REGISTRAR_PROVIDER=rdap
RESELLERCLUB_ENV=live
RESELLERCLUB_RESELLER_ID=
RESELLERCLUB_API_KEY=
RESELLERCLUB_CUSTOMER_ID=
REGISTRAR_NAMESERVERS=
REGISTRAR_MAX_YEARLY_COST=5000
# on = update the domain price list's purchase prices from the registrar once a day (ResellerClub only).
REGISTRAR_PRICE_SYNC=on

# ─── Uploaded files ───
# local = a persistent Docker volume on the server (backed up by infra/backup/backup.sh).
# s3 = a private S3 (or S3-compatible) bucket; see DEPLOYMENT.md, "Uploaded files in S3".
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=

# ─── Virus scanning (the clamav service in docker-compose.yml) ───
VIRUS_SCAN=clamav

# ─── Optional ───
LOG_LEVEL=info
# Error tracking: a Sentry DSN, or leave empty.
SENTRY_DSN=
# Billing rhythm. The defaults are sensible; change them only on purpose.
RENEWAL_LEAD_DAYS=14
PAST_DUE_GRACE_DAYS=7
ABANDONED_ORDER_DAYS=14
