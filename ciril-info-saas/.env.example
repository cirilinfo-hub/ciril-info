# ─────────────────────────────────────────────────────────────────────────────
# CirilInfo SaaS — environment template
# Copy to `.env` (local) or the server's secret store (production).
# NEVER commit a real .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_NAME="CirilInfo"

# ─── URLs (production values in comments) ───
PUBLIC_WEB_URL=http://localhost:4200          # https://cirilinfo.com
CUSTOMER_PORTAL_URL=http://localhost:4200/portal   # https://app.cirilinfo.com
ADMIN_PORTAL_URL=http://localhost:4200/admin  # https://admin.cirilinfo.com
API_URL=http://localhost:3000                 # https://api.cirilinfo.com
API_PORT=3000
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:4200
# Cookie domain for the refresh-token cookie. Empty for localhost; ".cirilinfo.com" is NOT needed
# in production because the cookie is scoped to api.cirilinfo.com only.
COOKIE_DOMAIN=

# ─── PostgreSQL ───
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
DB_PLATFORM_PASSWORD=change-me-platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cirilinfo
# Used by Prisma migrations (schema owner)
DATABASE_URL=postgresql://cirilinfo_owner:change-me-owner@localhost:5432/cirilinfo?schema=public
# Runtime: customer requests (RLS enforced)
DATABASE_URL_APP=postgresql://cirilinfo_app:change-me-app@localhost:5432/cirilinfo?schema=public
# Runtime: admin portal, auth, worker (RLS bypass, guarded by platform RBAC)
DATABASE_URL_PLATFORM=postgresql://cirilinfo_platform:change-me-platform@localhost:5432/cirilinfo?schema=public

# ─── Redis / BullMQ ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# ─── Auth ───
# Signing key for 15-minute access tokens (min 32 chars).
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-xxxxxxxx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte base64 key for AES-256-GCM encryption of provider credentials, MFA secrets, EPP codes.
DATA_ENCRYPTION_KEY=change-me-base64-32-bytes
# Seeded Super Admin (first run only). Password is required; it must be changed after first login.
SEED_SUPERADMIN_EMAIL=admin@cirilinfo.com
SEED_SUPERADMIN_PASSWORD=
# Development only: add clearly-flagged SAMPLE plans, prices, testimonials and FAQs (never real data).
# Refused when NODE_ENV=production. Remove them with: npm --prefix apps/api run db:purge-samples
SEED_SAMPLE_DATA=false

# ─── Email ───
# mailpit (local) | resend | ses
EMAIL_PROVIDER=mailpit
EMAIL_FROM="CirilInfo <no-reply@cirilinfo.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
AWS_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# ─── Payments ───
# mock | razorpay | stripe   (mock is refused when NODE_ENV=production)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Hosting panel ───
# mock | cpanel | plesk
HOSTING_PROVIDER=mock

# ─── Domain registrar ───
# mock | <registrar adapter key>
REGISTRAR_PROVIDER=mock

# ─── Object storage (S3-compatible) ───
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Observability ───
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
