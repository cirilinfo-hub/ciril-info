# ─────────────────────────────────────────────────────────────────────────────
# CirilInfo SaaS — environment template
# Copy to `.env` (local) or the server's secret store (production).
# NEVER commit a real .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_NAME="CirilInfo"

# ─── URLs (production values in comments) ───
PUBLIC_WEB_URL=http://localhost:4200          # https://cirilinfo.com
CUSTOMER_PORTAL_URL=http://localhost:4200/portal   # https://app.cirilinfo.com
ADMIN_PORTAL_URL=http://localhost:4200/admin  # https://admin.cirilinfo.com
API_URL=http://localhost:3000                 # https://api.cirilinfo.com
API_PORT=3000
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:4200
# Cookie domain for the refresh-token cookie. Empty for localhost; ".cirilinfo.com" is NOT needed
# in production because the cookie is scoped to api.cirilinfo.com only.
COOKIE_DOMAIN=

# ─── PostgreSQL ───
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
DB_PLATFORM_PASSWORD=change-me-platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cirilinfo
# Used by Prisma migrations (schema owner)
DATABASE_URL=postgresql://cirilinfo_owner:change-me-owner@localhost:5432/cirilinfo?schema=public
# Runtime: customer requests (RLS enforced)
DATABASE_URL_APP=postgresql://cirilinfo_app:change-me-app@localhost:5432/cirilinfo?schema=public
# Runtime: admin portal, auth, worker (RLS bypass, guarded by platform RBAC)
DATABASE_URL_PLATFORM=postgresql://cirilinfo_platform:change-me-platform@localhost:5432/cirilinfo?schema=public

# ─── Redis / BullMQ ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# ─── Auth ───
# Signing key for 15-minute access tokens (min 32 chars).
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-xxxxxxxx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte base64 key for AES-256-GCM encryption of provider credentials, MFA secrets, EPP codes.
DATA_ENCRYPTION_KEY=change-me-base64-32-bytes
# Seeded Super Admin (first run only). Password is required; it must be changed after first login.
SEED_SUPERADMIN_EMAIL=admin@cirilinfo.com
SEED_SUPERADMIN_PASSWORD=
# Development only: add clearly-flagged SAMPLE plans, prices, testimonials and FAQs (never real data).
# Refused when NODE_ENV=production. Remove them with: npm --prefix apps/api run db:purge-samples
SEED_SAMPLE_DATA=false

# ─── Email ───
# mailpit (local) | resend | ses
EMAIL_PROVIDER=mailpit
EMAIL_FROM="CirilInfo <no-reply@cirilinfo.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
AWS_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# ─── Payments ───
# mock | razorpay   (stripe is planned; mock is refused when NODE_ENV=production). Setup: see PAYMENTS.md. Secrets go in the server's .env ONLY.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Where Razorpay's API lives. Leave as is (only tests change it).
# RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Saved cards and automatic renewal payments. Only after Razorpay has switched on Recurring Payments (cards). See PAYMENTS.md.
RAZORPAY_SAVED_CARDS=false
# The most one automatic charge may take, in rupees (RBI's limit without the customer is 15000).
CARD_AUTOPAY_MAX_AMOUNT=15000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Hosting panel ───
# mock   = pretend panel, accounts appear by themselves (development only)
# manual = every set-up, suspend and plan change becomes a task for staff, who do it in their own
#          panel and mark it done in Admin > Hosting (use this to sell before a panel is connected)
# cpanel = a real WHM/cPanel server (fill in the CPANEL_* values below; see HOSTING.md)
# plesk  = not built yet
HOSTING_PROVIDER=mock

# Where customers' DNS records are edited: mock (in memory, development only) | cpanel (the WHM server below) | none (switched off)
DNS_PROVIDER=mock

# cPanel/WHM. Put the real values in the server's .env only, never in chat, git or a screenshot.
CPANEL_HOST=
CPANEL_PORT=2087
# The WHM user the API token belongs to (root, or a reseller)
CPANEL_USER=
CPANEL_API_TOKEN=
# verify = normal HTTPS | skip = do not check the certificate (self-signed server) | off = plain HTTP, tests only
CPANEL_TLS=verify

# ─── Domain registrar ───
# mock = pretend answers (development only)
# rdap = ask the public registry whether a name is taken (real answers, no registrar account needed). Registering, renewing
#        and transferring is done by hand at your registrar.
# godaddy = searches and paid orders go through GoDaddy (see DOMAINS.md).
REGISTRAR_PROVIDER=mock
# GoDaddy, used when REGISTRAR_PROVIDER=godaddy. Real keys go in the server .env only, never in git.
# ote = GoDaddy's test environment (nothing is bought); production = real orders paid from your GoDaddy account.
GODADDY_ENV=ote
GODADDY_API_KEY=
GODADDY_API_SECRET=
# Comma-separated nameservers for new domains, for example your WHM server's. Empty = GoDaddy's own.
GODADDY_NAMESERVERS=
# The most one name may cost per year, in your GoDaddy account's currency. Dearer (premium) names go to staff instead.
GODADDY_MAX_YEARLY_COST=50

# ─── Object storage (S3-compatible) ───
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# With s3: a PRIVATE bucket. Keys in the server's .env only. See DEPLOYMENT.md, "Uploaded files in S3".
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible stores (Cloudflare R2, Backblaze B2, Wasabi, MinIO). Empty for Amazon S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Optional folder inside the bucket
S3_PREFIX=

# ─── Virus scanning ───
# off | clamav. With clamav, uploads are checked by a ClamAV daemon first and refused if infected or if it cannot be
# reached. Locally: docker compose -f docker-compose.dev.yml --profile scan up -d clamav
VIRUS_SCAN=off
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ─── Observability ───
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
